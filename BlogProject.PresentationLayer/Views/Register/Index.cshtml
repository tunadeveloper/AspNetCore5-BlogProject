@using BlogProject.EntityLayer.Concrete
@model Writer
@{
    ViewData["Title"] = "Kayıt Ol";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}
<script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
<script src="/lib/jquery/dist/jquery.js"></script>

<div class="container my-5" style="flex: 1; display: flex; align-items: center; justify-content: center; min-height: 60vh;">
	<div class="row w-100">
		<div class="col-lg-8 col-md-10 mx-auto">
			<div class="card" style="background: white; border-radius: 20px; box-shadow: 0 8px 24px rgba(69, 40, 41, 0.15); padding: 3rem;">
				<div class="text-center mb-4">
					<h2 class="mb-2" style="color: var(--primary-color); font-weight: 700;">
						<i class="fas fa-user-plus me-2"></i>Hemen Kayıt Ol
					</h2>
					<p class="text-muted">Yeni hesap oluşturun ve blog yazmaya başlayın</p>
				</div>

				@using (Html.BeginForm("Index", "Register", FormMethod.Post))
				{
					<div class="row">
						<div class="col-md-6 mb-3">
							@Html.LabelFor(x => x.WriterName, "İsim Soyisim", new { @class = "form-label fw-bold", style = "color: var(--primary-color);" })
							@Html.TextBoxFor(x => x.WriterName, new { @class = "form-control", placeholder = "Adınız ve Soyadınız", required = "required", style = "border: 2px solid var(--accent-color); border-radius: 10px; padding: 0.75rem;" })
							@Html.ValidationMessageFor(x => x.WriterName, "", new { @class = "text-danger" })
						</div>

						<div class="col-md-6 mb-3">
							@Html.LabelFor(x => x.WriterEmail, "E-Posta", new { @class = "form-label fw-bold", style = "color: var(--primary-color);" })
							@Html.TextBoxFor(x => x.WriterEmail, new { @class = "form-control", type = "email", placeholder = "ornek@email.com", required = "required", style = "border: 2px solid var(--accent-color); border-radius: 10px; padding: 0.75rem;" })
							@Html.ValidationMessageFor(x => x.WriterEmail, "", new { @class = "text-danger" })
						</div>
					</div>

					<div class="mb-4">
						@Html.LabelFor(x => x.WriterPassword, "Şifre", new { @class = "form-label fw-bold", style = "color: var(--primary-color);" })
						@Html.PasswordFor(x => x.WriterPassword, new { @class = "form-control", placeholder = "Güçlü bir şifre oluşturun", required = "required", style = "border: 2px solid var(--accent-color); border-radius: 10px; padding: 0.75rem;" })
						@Html.ValidationMessageFor(x => x.WriterPassword, "", new { @class = "text-danger" })
					</div>

					<div class="mb-4">
						<a href="#" id="agreement" style="color: var(--primary-color); text-decoration: none; font-weight: 500;">
							<i class="fas fa-file-contract me-2"></i>Tüm Şartları Okudum, Kabul Ediyorum.
						</a>
					</div>

					<button type="submit" class="btn w-100 mb-3" id="success" style="background: var(--gradient-1); color: white; border: none; padding: 0.75rem; border-radius: 10px; font-weight: 600; font-size: 1.1rem;">
						<i class="fas fa-user-plus me-2"></i>Kayıt Ol
					</button>

					<div class="text-center">
						<p class="mb-0" style="color: var(--secondary-color);">
							Zaten hesabınız var mı? 
							<a href="/Login/Index/" style="color: var(--primary-color); text-decoration: none; font-weight: 600;">
								Giriş Yap
							</a>
						</p>
					</div>
				}
			</div>
		</div>
	</div>
</div>

<script>
	$("#success").click(function (e) {
		e.preventDefault();

		swal({
			title: "Harika!",
			text: "Kayıdınız başarılı bir şekilde gerçekleşti!",
			icon: "success",
			button: "Tamam"
		}).then((willOk) => {
			if (willOk) {
				$("form").submit();
			}
		});
	});

	let agreementText =
		"Bu sözleşme, Blog platformuna üye olan kullanıcı ile yönetim arasında düzenlenmiştir. Kullanıcı, üyelik işlemini tamamladığında bu sözleşmeyi kabul etmiş sayılır.\n\n" +
		"Kullanıcı, sisteme kayıt olurken doğru ve güncel bilgiler vermekle yükümlüdür. Paylaştığı tüm içeriklerden kendisi sorumludur. Küfür, hakaret, tehdit, şiddet, ayrımcılık veya telif hakkı ihlali içeren paylaşımlar yasaktır.\n\n" +
		"Yönetim, kullanıcıların içeriklerini önceden bildirim yapmadan silebilir, kurallara aykırı davranan kullanıcıların hesaplarını askıya alabilir veya kalıcı olarak silebilir. Ayrıca, site üzerinde tasarım ve kullanım koşullarında değişiklik yapma hakkını saklı tutar.\n\n" +
		"Kullanıcının kişisel verileri gizlilik politikası çerçevesinde saklanır ve yalnızca bilgilendirme amacıyla kullanılabilir.\n\n" +
		"Site, kullanıcıların paylaşımlarından doğan hukuki ve cezai sorumluluk kabul etmez. Kullanıcı, paylaşımlarının üçüncü kişilerin haklarını ihlal etmediğini taahhüt eder.\n\n" +
		"Kullanıcı, siteye üye olduğu anda işbu sözleşme yürürlüğe girer.";

	$("#agreement").click(function () {
		swal({
			title: "Kullanıcı Sözleşmesi",
			text: agreementText,
			button: "Okudum, Onaylıyorum!"
		});
	});
</script>
