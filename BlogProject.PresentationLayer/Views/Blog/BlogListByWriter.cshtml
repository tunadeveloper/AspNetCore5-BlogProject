@using BlogProject.EntityLayer.Concrete
@{
    ViewData["Title"] = "Bloglarım";
    Layout = "~/Views/Shared/_WriterLayout.cshtml";
}
@model List<Blog>

<div class="main-content">
    <div class="content-wrapper">
        <h1 class="page-title">
            <i class="fas fa-blog me-2"></i>Bloglarım
        </h1>

        <div class="admin-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="mb-0">Blog Listesi</h5>
                <a href="/Blog/CreateBlog/" class="btn btn-modern" style="background: linear-gradient(90deg, #6366f1, #8b5cf6); color: white;">
                    <i class="fas fa-plus me-2"></i>Yeni Blog
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead style="background: #f8fafc;">
                        <tr>
                            <th>#</th>
                            <th>Başlık</th>
                            <th>Tarih</th>
                            <th>Kategori</th>
                            <th>Durum</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.BlogId</td>
                                <td>@item.BlogTitle</td>
                                <td>@item.BlogCreateDate.ToShortDateString()</td>
                                <td><span class="badge" style="background: linear-gradient(90deg, #6366f1, #8b5cf6); color: white;">@item.Category.CategoryName</span></td>
                                <td>
                                    @if (item.BlogStatus)
                                    {
                                        <span class="badge bg-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Pasif</span>
                                    }
                                </td>
                                <td>
                                    <a href="/Blog/UpdateBlog/@item.BlogId" class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit"></i> Güncelle
                                    </a>
                                    <a href="/Blog/DeleteBlog/@item.BlogId" class="btn btn-sm btn-danger" onclick="return confirm('Bu blog yazısını silmek istediğinizden emin misiniz?')">
                                        <i class="fas fa-trash"></i> Sil
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
