@using X.PagedList
@using X.PagedList.Mvc.Core
@using BlogProject.EntityLayer.Concrete
@model IPagedList<Blog>
@{
    ViewData["Title"] = "Bloglar";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="container my-5" style="flex: 1;">
	<nav aria-label="breadcrumb" class="modern-breadcrumb">
		<ol class="breadcrumb">
			<li class="breadcrumb-item"><a href="/Blog/Index/">Anasayfa</a></li>
			<li class="breadcrumb-item active">Bloglar</li>
		</ol>
	</nav>

	<h1 class="section-title">Blog Yazılarımız</h1>

	<div class="row mb-4">
		<div class="col-12">
			<div class="card" style="background: white; border-radius: 15px; padding: 1.5rem; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.07);">
				<h5 class="mb-3" style="color: var(--primary-color); font-weight: 600;">
					<i class="fas fa-filter me-2"></i>Kategorilere Göre Filtrele
				</h5>
				<div class="d-flex flex-wrap gap-2">
					<a href="/Blog/Index/" class="btn @(ViewBag.SelectedCategoryId == null ? "btn-primary" : "btn-outline-primary")" 
					   style="@(ViewBag.SelectedCategoryId == null ? "background: var(--primary-color); border-color: var(--primary-color);" : "")">
						Tümü
					</a>
					@foreach (var category in ViewBag.Categories as List<Category>)
					{
						<a href="/Blog/Index/?categoryId=@category.CategoryId" 
						   class="btn @(ViewBag.SelectedCategoryId != null && (int)ViewBag.SelectedCategoryId == category.CategoryId ? "btn-primary" : "btn-outline-primary")"
						   style="@(ViewBag.SelectedCategoryId != null && (int)ViewBag.SelectedCategoryId == category.CategoryId ? "background: var(--primary-color); border-color: var(--primary-color);" : "")">
							@category.CategoryName
						</a>
					}
				</div>
			</div>
		</div>
	</div>

	@if (Model.Any())
	{
		<div class="row g-4">
			@foreach (var item in Model)
			{
				<div class="col-lg-4 col-md-6">
					<div class="blog-card">
						<a href="/Blog/BlogDetails/@item.BlogId">
							<img src="@item.BlogThumnailImage" class="card-img-top" alt="@item.BlogTitle" 
								 onerror="this.src='https://via.placeholder.com/400x250?text=Blog+Image'">
						</a>
						<div class="blog-card-body">
							<div class="blog-meta">
								<span><i class="far fa-calendar-alt"></i> @item.BlogCreateDate.ToString("dd MMM yyyy")</span>
								<span><i class="far fa-comment"></i> @(item.Comments?.Count ?? 0)</span>
								<span><i class="fas fa-tag"></i> @item.Category.CategoryName</span>
							</div>
							<h5 class="blog-card-title">
								<a href="/Blog/BlogDetails/@item.BlogId">@item.BlogTitle</a>
							</h5>
							<p class="blog-card-text">
								@(item.BlogContent != null && item.BlogContent.Length > 150 
									? item.BlogContent.Substring(0, 150) + "..." 
									: item.BlogContent ?? "")
							</p>
							<a href="/Blog/BlogDetails/@item.BlogId" class="btn btn-read-more">
								Devamını Oku <i class="fas fa-arrow-right ms-2"></i>
							</a>
						</div>
					</div>
				</div>
			}
		</div>

		<div class="pagination mt-5">
			@Html.PagedListPager(Model, page => Url.Action("Index", new { page, categoryId = ViewBag.SelectedCategoryId }))
		</div>
	}
	else
	{
		<div class="alert alert-info text-center" style="background: var(--light-accent); border-color: var(--accent-color); color: var(--primary-color);">
			<i class="fas fa-info-circle me-2"></i>Bu kategoride henüz blog yazısı bulunmamaktadır.
		</div>
	}
</div>

<style>
	.pagination {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
	}

	.pagination li {
		display: inline-block;
	}

	.pagination a,
	.pagination span {
		display: inline-block;
		padding: 0.5rem 1rem;
		border-radius: 8px;
		text-decoration: none;
		color: var(--primary-color);
		background: white;
		border: 2px solid var(--accent-color);
		transition: all 0.3s ease;
		font-weight: 500;
	}

	.pagination a:hover {
		background: var(--primary-color);
		color: white;
		border-color: var(--primary-color);
		transform: translateY(-2px);
	}

	.pagination .active span {
		background: var(--primary-color);
		color: white;
		border-color: var(--primary-color);
	}

	.pagination .disabled span {
		opacity: 0.5;
		cursor: not-allowed;
	}
</style>
