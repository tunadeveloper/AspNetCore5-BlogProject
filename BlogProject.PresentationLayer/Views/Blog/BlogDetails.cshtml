@using BlogProject.EntityLayer.Concrete
@model Blog
@{
    ViewData["Title"] = Model?.BlogTitle ?? "Blog Detayı";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

@if (Model == null)
{
    <div class="container my-5">
        <div class="alert alert-danger">
            <h4>Blog bulunamadı!</h4>
            <p>Aradığınız blog yazısı bulunamadı veya silinmiş olabilir.</p>
            <a href="/Blog/Index/" class="btn btn-primary">Blog Listesine Dön</a>
        </div>
    </div>
    return;
}

<div class="container my-5">
	<nav aria-label="breadcrumb" class="modern-breadcrumb">
		<ol class="breadcrumb">
			<li class="breadcrumb-item"><a href="/Blog/Index/">Anasayfa</a></li>
			<li class="breadcrumb-item"><a href="/Blog/Index/">Bloglar</a></li>
			<li class="breadcrumb-item active">@Model.BlogTitle</li>
		</ol>
	</nav>

	<div class="row">
		<div class="col-lg-8">
			<article class="blog-detail-card" style="background: white; border-radius: 15px; padding: 2rem; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.07);">
				<div class="blog-detail-image mb-4">
					<img src="@Model.BlogImage" class="img-fluid rounded" alt="@Model.BlogTitle" 
						 onerror="this.src='https://via.placeholder.com/800x400?text=Blog+Image'">
				</div>
				
				<div class="blog-detail-meta mb-4 d-flex gap-4 flex-wrap">
					<span class="text-muted">
						<i class="far fa-calendar-alt me-2"></i>@Model.BlogCreateDate.ToString("dd MMMM yyyy")
					</span>
					<span class="text-muted">
						<i class="fas fa-tag me-2"></i>@(Model.Category?.CategoryName ?? "Kategori Yok")
					</span>
					<span class="text-muted">
						<i class="far fa-user me-2"></i>@(Model.Writer?.WriterName ?? "Yazar Yok")
					</span>
					<span class="text-muted">
						<i class="far fa-comment me-2"></i>@(Model.Comments?.Count ?? 0) Yorum
					</span>
				</div>

				<h1 class="blog-detail-title mb-4" style="font-size: 2.5rem; font-weight: 800; line-height: 1.2;">
					@Model.BlogTitle
				</h1>

				<div class="blog-detail-content" style="font-size: 1.125rem; line-height: 1.8; color: #475569;">
					@Html.Raw(Model.BlogContent?.Replace("\n", "<br/>"))
				</div>
			</article>

			<div class="mt-5">
				@await Component.InvokeAsync("_CommentListByBlogComponentPartial", ViewBag.id)
			</div>
		</div>

		<div class="col-lg-4">
			<aside class="blog-sidebar">
				@await Component.InvokeAsync("_CategoryListComponentPartial")
				@await Component.InvokeAsync("_WriterLastBlogComponentPartial")
			</aside>
		</div>
	</div>
</div>

<style>
	.blog-detail-card {
		animation: fadeIn 0.5s ease-in;
	}

	@@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.blog-detail-image img {
		width: 100%;
		height: auto;
		max-height: 500px;
		object-fit: cover;
	}

	.blog-sidebar {
		position: sticky;
		top: 2rem;
	}

	.blog-sidebar a {
		text-decoration: none !important;
		color: var(--primary-color) !important;
	}

	.blog-sidebar a:hover {
		color: var(--secondary-color) !important;
		text-decoration: none !important;
	}
</style>
