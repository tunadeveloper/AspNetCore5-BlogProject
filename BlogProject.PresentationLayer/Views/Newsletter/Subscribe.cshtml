@using BlogProject.EntityLayer.Concrete
@model Newsletter

<div>
	<h5 class="mb-3" style="color: var(--primary-color); font-weight: 700;">
		<i class="fas fa-envelope me-2"></i>Bültenimize Kaydolun
	</h5>
	<p class="mb-3" style="color: var(--secondary-color); font-size: 0.9rem;">
		Yeni gelişmelerden anında haberdar olun!
	</p>
	@using (Html.BeginForm("Subscribe", "Newsletter", FormMethod.Post))
	{
		<div class="mb-3">
			@Html.TextBoxFor(x => x.Email, new { 
				@class = "form-control", 
				placeholder = "E-Posta Adresiniz",
				style = "border: 2px solid var(--accent-color); border-radius: 10px; padding: 0.75rem;"
			})
			@Html.ValidationMessageFor(x => x.Email, "", new { @class = "text-danger" })
		</div>
		<button type="submit" class="btn w-100" 
				style="background: var(--gradient-1); color: white; border: none; padding: 0.75rem; border-radius: 10px; font-weight: 600; transition: all 0.3s ease;">
			<i class="fas fa-paper-plane me-2"></i>Hemen Abone Ol
		</button>
	}
</div>

<style>
	.newsletter-form button:hover {
		transform: translateY(-2px);
		box-shadow: 0 4px 12px rgba(69, 40, 41, 0.3);
	}
</style>
