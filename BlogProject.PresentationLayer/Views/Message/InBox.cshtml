@using BlogProject.EntityLayer.Concrete
@model List<Message2>
@{
    ViewData["Title"] = "Mesajlar";
    Layout = "~/Views/Shared/_WriterLayout.cshtml";
}

<div class="main-content">
    <div class="content-wrapper">
        <h1 class="page-title">
            <i class="fas fa-envelope me-2"></i>Mesajlar
        </h1>

        <div class="admin-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="mb-0">Gelen Mesajlar</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead style="background: #f8fafc;">
                        <tr>
                            <th>Gönderen</th>
                            <th>Konu</th>
                            <th>Tarih</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="@item.SenderUser.WriterImage" alt="@item.SenderUser.WriterName" 
                                             class="rounded-circle me-2" style="width: 40px; height: 40px; object-fit: cover;"
                                             onerror="this.src='https://via.placeholder.com/40?text=U'">
                                        <span>@item.SenderUser.WriterName</span>
                                    </div>
                                </td>
                                <td>@item.Subject</td>
                                <td><span class="badge" style="background: #f8fafc; color: #64748b;">@item.CreatedDate.ToShortDateString()</span></td>
                                <td>
                                    <a href="/Message/MessageDetails/@item.MessageId" class="btn btn-sm btn-primary">
                                        <i class="fas fa-eye"></i> Mesajı Gör
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
