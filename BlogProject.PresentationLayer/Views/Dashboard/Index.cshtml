@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_WriterLayout.cshtml";
}

<div class="main-content">
    <div class="content-wrapper">
        <h1 class="page-title">
            <i class="fas fa-home me-2"></i>Dashboard
        </h1>

        <div class="row g-4 mb-4">
            <div class="col-lg-4 col-md-6">
                <div class="stat-card primary">
                    <div class="stat-icon">
                        <i class="fas fa-blog"></i>
                    </div>
                    <div class="stat-value">@ViewBag.allBlogCount</div>
                    <div class="stat-label">Tüm Bloglar</div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="stat-card success">
                    <div class="stat-icon">
                        <i class="fas fa-bookmark"></i>
                    </div>
                    <div class="stat-value">@ViewBag.myBlogCount</div>
                    <div class="stat-label">Benim Bloglarım</div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="stat-card warning">
                    <div class="stat-icon">
                        <i class="fas fa-calendar-week"></i>
                    </div>
                    <div class="stat-value">@ViewBag.blogCountLastSevenDays</div>
                    <div class="stat-label">Bu Hafta</div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                @await Component.InvokeAsync("_BlogListDashboardComponentPartial")
            </div>
            <div class="col-lg-4">
                @await Component.InvokeAsync("_DashboardCategoryListComponentPartial")
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.getElementById('sidebarToggle')?.addEventListener('click', function() {
        document.getElementById('sidebar').classList.toggle('show');
    });
</script>
