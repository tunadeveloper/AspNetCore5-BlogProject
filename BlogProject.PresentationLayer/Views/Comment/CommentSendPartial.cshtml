@model BlogProject.EntityLayer.Concrete.Comment
<div class="comment-top">
	<h4>Düşüncelerin Neler?</h4>
	<br /> <br />
	<div class="comment-bottom">
		@using (Html.BeginForm("CreateComment", "Comment", FormMethod.Post))
		{
			 @Html.TextBoxFor(x=>x.CommentUsername, new{@class="form-control", placeholder="İsim Soyisim"}) 
			 <br />
			@Html.TextBoxFor(x => x.CommentTitle, new { @class = "form-control", placeholder = "Başlık" })
			<br />
			@Html.TextAreaFor(x => x.CommentContent, new { @class = "form-control", placeholder = "Detay..." })
			<br />
			<button type="submit" class="btn comment-submit-btn">Gönder</button>
		}
	</div>
</div>

<style>
	.comment-submit-btn {
		background: var(--primary-color);
		border-color: var(--primary-color);
		color: white;
		padding: 0.7rem 2rem;
		border-radius: 8px;
		font-weight: 600;
		transition: all 0.3s ease;
		border: none;
		cursor: pointer;
	}

	.comment-submit-btn:hover {
		background: var(--secondary-color);
		border-color: var(--secondary-color);
		color: white;
		transform: translateY(-2px);
		box-shadow: 0 4px 8px rgba(69, 40, 41, 0.2);
	}

	.comment-submit-btn:active {
		transform: translateY(0);
	}
</style>