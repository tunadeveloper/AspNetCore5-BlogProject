@using BlogProject.EntityLayer.Concrete
@model List<Blog>

<div class="card mb-4" style="background: white; border-radius: 15px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.07); padding: 1.5rem;">
	<h5 class="mb-3" style="color: var(--primary-color); font-weight: 700;">
		<i class="fas fa-newspaper me-2"></i>Diğer Bloglar
	</h5>
	
	@foreach(var item in Model.Take(5))
	{
		<div class="d-flex mb-3 pb-3" style="border-bottom: 1px solid var(--accent-color);">
			<div class="flex-shrink-0 me-3">
				<a href="/Blog/BlogDetails/@item.BlogId" style="text-decoration: none; display: block;">
					<img src="@item.BlogThumnailImage" class="rounded" alt="@item.BlogTitle" 
						 style="width: 80px; height: 80px; object-fit: cover; border: 2px solid var(--accent-color);"
						 onerror="this.src='https://via.placeholder.com/80?text=Blog'">
				</a>
			</div>
			<div class="flex-grow-1">
				<h6 class="mb-2" style="margin: 0;">
					<a href="/Blog/BlogDetails/@item.BlogId" 
					   style="color: var(--primary-color); text-decoration: none; font-weight: 600; font-size: 0.9rem; line-height: 1.4; display: block;">
						@(item.BlogTitle?.Length > 50 ? item.BlogTitle.Substring(0, 50) + "..." : item.BlogTitle)
					</a>
				</h6>
				<div class="text-muted" style="font-size: 0.75rem; color: var(--secondary-color);">
					<i class="far fa-clock me-1"></i>@item.BlogCreateDate.ToString("dd MMM yyyy")
				</div>
			</div>
		</div>
	}
</div>

<style>
	.blog-sidebar a {
		text-decoration: none !important;
		color: var(--primary-color) !important;
	}
	
	.blog-sidebar a:hover {
		color: var(--secondary-color) !important;
		text-decoration: none !important;
	}
</style>
