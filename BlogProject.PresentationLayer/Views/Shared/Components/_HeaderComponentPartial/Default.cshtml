<header class="modern-header">
	<nav class="navbar navbar-expand-lg">
		<div class="container">
			<a class="navbar-brand" href="/Blog/Index/">
				<i class="fas fa-blog me-2"></i>Modern Blog
			</a>
			<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" 
					aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
				<span class="navbar-toggler-icon"></span>
			</button>
			<div class="collapse navbar-collapse" id="navbarNav">
				<ul class="navbar-nav me-auto">
					<li class="nav-item">
						<a class="nav-link" href="/Blog/Index/">Anasayfa</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" href="/About/Index/">Hakkımızda</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" href="/Contact/Index/">İletişim</a>
					</li>
				</ul>
				<div class="d-flex align-items-center gap-3">
					@if (User.Identity.IsAuthenticated)
					{
						<span class="text-white me-2">Hoş geldiniz, @User.Identity.Name</span>
						<a href="/Login/LogOut" class="btn btn-login">Çıkış</a>
					}
					else
					{
						<a href="/Login/Index/" class="btn btn-login">
							<i class="fas fa-sign-in-alt me-2"></i>Giriş Yap
						</a>
						<a href="/Register/Index/" class="btn btn-outline-light">
							<i class="fas fa-user-plus me-2"></i>Kayıt Ol
						</a>
					}
				</div>
			</div>
		</div>
	</nav>
</header>
