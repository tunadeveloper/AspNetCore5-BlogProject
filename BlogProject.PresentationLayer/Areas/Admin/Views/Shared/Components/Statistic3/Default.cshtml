@using BlogProject.EntityLayer.Concrete
@{
    var lastMessages = ViewBag.LastMessages as List<Contact>;
}

<div class="col-lg-6 col-md-6 mb-4">
    <div class="admin-card" style="background: white; border-radius: 15px; padding: 1.5rem; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.07);">
        <h5 class="mb-3" style="color: var(--primary-color); font-weight: 700; font-size: 1rem;">
            <i class="fas fa-chart-bar me-2"></i>Detaylı İstatistikler
        </h5>
        
        <div class="row g-2 mb-4">
            <div class="col-6">
                <div class="text-center p-2" style="background: rgba(16, 185, 129, 0.1); border-radius: 8px;">
                    <div style="font-size: 1.5rem; font-weight: 800; color: #10b981;">@ViewBag.ActiveBlogCount</div>
                    <div style="font-size: 0.75rem; color: var(--secondary-color); font-weight: 500;">Aktif Blog</div>
                </div>
            </div>
            <div class="col-6">
                <div class="text-center p-2" style="background: rgba(99, 102, 241, 0.1); border-radius: 8px;">
                    <div style="font-size: 1.5rem; font-weight: 800; color: var(--primary-color);">@ViewBag.WriterCount</div>
                    <div style="font-size: 0.75rem; color: var(--secondary-color); font-weight: 500;">Aktif Yazar</div>
                </div>
            </div>
            <div class="col-6">
                <div class="text-center p-2" style="background: rgba(245, 158, 11, 0.1); border-radius: 8px;">
                    <div style="font-size: 1.5rem; font-weight: 800; color: #f59e0b;">@ViewBag.CategoryCount</div>
                    <div style="font-size: 0.75rem; color: var(--secondary-color); font-weight: 500;">Aktif Kategori</div>
                </div>
            </div>
            <div class="col-6">
                <div class="text-center p-2" style="background: rgba(139, 92, 246, 0.1); border-radius: 8px;">
                    <div style="font-size: 1.5rem; font-weight: 800; color: #8b5cf6;">@ViewBag.NewsletterCount</div>
                    <div style="font-size: 0.75rem; color: var(--secondary-color); font-weight: 500;">Bülten Abonesi</div>
                </div>
            </div>
            <div class="col-12">
                <div class="text-center p-2" style="background: rgba(239, 68, 68, 0.1); border-radius: 8px;">
                    <div style="font-size: 1.5rem; font-weight: 800; color: #ef4444;">@ViewBag.LastWeekBlogCount</div>
                    <div style="font-size: 0.75rem; color: var(--secondary-color); font-weight: 500;">Son 7 Günde Eklenen Blog</div>
                </div>
            </div>
        </div>

        <hr style="border-color: var(--accent-color); margin: 1rem 0;">

        <h6 class="mb-2" style="color: var(--primary-color); font-weight: 600; font-size: 0.875rem;">
            <i class="fas fa-envelope me-2"></i>Son Gelen 5 Mesaj
        </h6>
        
        @if (lastMessages != null && lastMessages.Any())
        {
            <div class="d-flex flex-column gap-2">
                @foreach (var message in lastMessages)
                {
                    <div class="p-2" style="background: var(--light-color); border-radius: 6px; border: 1px solid var(--accent-color);">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <h6 class="mb-0" style="color: var(--primary-color); font-weight: 600; font-size: 0.75rem;">
                                @(message.ContactUsername ?? "İsimsiz")
                            </h6>
                            <span style="color: var(--secondary-color); font-size: 0.65rem;">
                                @message.ContactDate.ToString("dd MMM yyyy")
                            </span>
                        </div>
                        <p class="mb-1" style="color: var(--primary-color); font-weight: 500; font-size: 0.7rem; margin: 0;">
                            <i class="fas fa-tag me-1"></i>@(message.ContactSubject ?? "Konu Yok")
                        </p>
                        <p class="mb-0" style="color: var(--secondary-color); font-size: 0.65rem; margin: 0; line-height: 1.3;">
                            @(message.ContactMessage?.Length > 50 ? message.ContactMessage.Substring(0, 50) + "..." : message.ContactMessage ?? "Mesaj içeriği yok")
                        </p>
                    </div>
                }
            </div>
        }
        else
        {
            <p style="color: var(--secondary-color); font-size: 0.75rem;">Henüz mesaj bulunmamaktadır.</p>
        }
    </div>
</div>
