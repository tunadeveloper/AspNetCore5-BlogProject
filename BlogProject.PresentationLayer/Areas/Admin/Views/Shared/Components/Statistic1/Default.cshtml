<div class="col-lg-3 col-md-6 mb-4">
    <div class="admin-stat-card primary">
        <div class="stat-icon">
            <i class="fas fa-blog"></i>
        </div>
        <div class="stat-value">@ViewBag.BlogCount</div>
        <div class="stat-label">Toplam Blog Sayısı</div>
    </div>
</div>
<div class="col-lg-3 col-md-6 mb-4">
    <div class="admin-stat-card success">
        <div class="stat-icon">
            <i class="fas fa-cloud-sun"></i>
        </div>
        <div class="stat-value">@ViewBag.Weather °C</div>
        <div class="stat-label">Hava Durumu</div>
    </div>
</div>
<div class="col-lg-3 col-md-6 mb-4">
    <div class="admin-stat-card warning">
        <div class="stat-icon">
            <i class="fas fa-envelope"></i>
        </div>
        <div class="stat-value">@ViewBag.ContactCount</div>
        <div class="stat-label">Toplam Mesaj</div>
    </div>
</div>
<div class="col-lg-3 col-md-6 mb-4">
    <div class="admin-stat-card danger">
        <div class="stat-icon">
            <i class="fas fa-comments"></i>
        </div>
        <div class="stat-value">@ViewBag.CommentCount</div>
        <div class="stat-label">Toplam Yorum</div>
    </div>
</div>
