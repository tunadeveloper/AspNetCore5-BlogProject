@using X.PagedList
@using X.PagedList.Mvc.Core
@using BlogProject.EntityLayer.Concrete
@model IPagedList<Comment>
@{
    ViewData["Title"] = "Yorum Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="mb-0">Yorum Yönetimi</h5>
    </div>
    <div class="table-responsive">
        <table class="admin-table table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Yorum Başlığı</th>
                    <th>Blog</th>
                    <th>Kullanıcı</th>
                    <th>Tarih</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CommentId</td>
                        <td>@item.CommentTitle</td>
                        <td>@(item.Blog?.BlogTitle ?? "Blog Bulunamadı")</td>
                        <td>@item.CommentUsername</td>
                        <td>@item.CommentDate.ToString("dd.MM.yyyy")</td>
                        <td>
                            <div class="form-check form-switch">
                                <input class="form-check-input status-toggle" type="checkbox" 
                                       data-id="@item.CommentId" 
                                       id="status_@item.CommentId"
                                       @(item.CommentStatus ? "checked" : "")>
                            </div>
                        </td>
                        <td>
                            <a href="/Admin/Comment/DeleteComment/@item.CommentId" class="btn btn-sm btn-danger" 
                               onclick="return confirm('Bu yorumu silmek istediğinizden emin misiniz?')">
                                <i class="fas fa-trash"></i> Sil
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <div class="pagination">
        @Html.PagedListPager(Model, page => Url.Action("Index", new { page }))
    </div>
</div>

<script>
$(document).ready(function() {
    $('.status-toggle').change(function() {
        var id = $(this).data('id');
        var status = $(this).is(':checked');
        var checkbox = $(this);
        
        $.ajax({
            url: '/Admin/Comment/ChangeStatus',
            type: 'POST',
            data: { id: id, status: status },
            success: function(result) {
                if (result.success) {
                    checkbox.prop('checked', result.newStatus);
                } else {
                    checkbox.prop('checked', !status);
                    alert('Durum güncellenirken hata oluştu');
                }
            },
            error: function() {
                checkbox.prop('checked', !status);
                alert('Durum güncellenirken hata oluştu');
            }
        });
    });
});
</script>
