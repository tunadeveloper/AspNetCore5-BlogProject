@model IEnumerable<BlogProject.EntityLayer.Concrete.About>
@{
    ViewData["Title"] = "Hakkımızda Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="mb-0">Hakkımızda Sayfası Yönetimi</h5>
        <a href="/Admin/About/CreateAbout" class="btn btn-modern" style="background: linear-gradient(90deg, #6366f1, #8b5cf6); color: white;">
            <i class="fas fa-plus me-2"></i>Yeni Ekle
        </a>
    </div>
    <div class="table-responsive">
        <table class="admin-table table table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Detay 1</th>
                    <th>Detay 2</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.AboutId</td>
                        <td>@(item.AboutDetail1?.Length > 50 ? item.AboutDetail1.Substring(0, 50) + "..." : item.AboutDetail1)</td>
                        <td>@(item.AboutDetail2?.Length > 50 ? item.AboutDetail2.Substring(0, 50) + "..." : item.AboutDetail2)</td>
                        <td>
                            <div class="form-check form-switch">
                                <input class="form-check-input status-toggle" type="checkbox" 
                                       data-id="@item.AboutId" 
                                       id="status_@item.AboutId"
                                       @(item.AboutStatus ? "checked" : "")>
                            </div>
                        </td>
                        <td>
                            <a href="/Admin/About/UpdateAbout/@item.AboutId" class="btn btn-sm btn-warning">
                                <i class="fas fa-edit"></i> Düzenle
                            </a>
                            <a href="/Admin/About/DeleteAbout/@item.AboutId" class="btn btn-sm btn-danger" 
                               onclick="return confirm('Bu kaydı silmek istediğinizden emin misiniz?')">
                                <i class="fas fa-trash"></i> Sil
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
$(document).ready(function() {
    $('.status-toggle').change(function() {
        var id = $(this).data('id');
        var status = $(this).is(':checked');
        var checkbox = $(this);
        
        $.ajax({
            url: '/Admin/About/ChangeStatus',
            type: 'POST',
            data: { id: id, status: status },
            success: function(result) {
                if (result.success) {
                    checkbox.prop('checked', result.newStatus);
                } else {
                    checkbox.prop('checked', !status);
                    alert('Durum güncellenirken hata oluştu');
                }
            },
            error: function() {
                checkbox.prop('checked', !status);
                alert('Durum güncellenirken hata oluştu');
            }
        });
    });
});
</script>
