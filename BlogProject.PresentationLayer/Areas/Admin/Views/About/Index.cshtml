@model IEnumerable<BlogProject.EntityLayer.Concrete.About>
@{
    ViewData["Title"] = "Hakkımızda Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Hakkımızda Sayfası Yönetimi</h3>
                    <div class="card-tools">
                        <a href="/Admin/About/CreateAbout" class="btn btn-primary btn-sm">
                            <i class="fas fa-plus"></i> Yeni Ekle
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Detay 1</th>
                                <th>Detay 2</th>
                                <th>Durum</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.AboutId</td>
                                    <td>@(item.AboutDetail1?.Length > 50 ? item.AboutDetail1.Substring(0, 50) + "..." : item.AboutDetail1)</td>
                                    <td>@(item.AboutDetail2?.Length > 50 ? item.AboutDetail2.Substring(0, 50) + "..." : item.AboutDetail2)</td>
                                    <td>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input status-toggle" type="checkbox" 
                                                   data-id="@item.AboutId" 
                                                   @(item.AboutStatus ? "checked" : "")>
                                        </div>
                                    </td>
                                    <td>
                                        <a href="/Admin/About/UpdateAbout/@item.AboutId" class="btn btn-warning btn-sm">
                                            <i class="fas fa-edit"></i> Düzenle
                                        </a>
                                        <a href="/Admin/About/DeleteAbout/@item.AboutId" class="btn btn-danger btn-sm" 
                                           onclick="return confirm('Bu kaydı silmek istediğinizden emin misiniz?')">
                                            <i class="fas fa-trash"></i> Sil
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    $('.status-toggle').change(function() {
        var id = $(this).data('id');
        var status = $(this).is(':checked');
        
        $.post('/Admin/About/ChangeStatus', { id: id, status: status }, function(result) {
            if (result.success) {
                toastr.success('Durum başarıyla güncellendi');
            } else {
                toastr.error('Durum güncellenirken hata oluştu');
            }
        });
    });
});
</script>
