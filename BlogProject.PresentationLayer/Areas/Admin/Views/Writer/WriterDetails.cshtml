@model BlogProject.EntityLayer.Concrete.Writer
@{
    ViewData["Title"] = "Yazar Detayları";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Yazar Detayları</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="text-center">
                                @if (!string.IsNullOrEmpty(Model.WriterImage))
                                {
                                    <img src="@Model.WriterImage" class="img-fluid rounded-circle" style="width: 150px; height: 150px; object-fit: cover;" alt="Yazar Resmi">
                                }
                                else
                                {
                                    <div class="bg-secondary rounded-circle d-flex align-items-center justify-content-center" style="width: 150px; height: 150px; margin: 0 auto;">
                                        <i class="fas fa-user fa-3x text-white"></i>
                                    </div>
                                }
                                <h4 class="mt-3">@Model.WriterName</h4>
                                <p class="text-muted">@Model.WriterEmail</p>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="card">
                                <div class="card-header">
                                    <h5>Yazar Bilgileri</h5>
                                </div>
                                <div class="card-body">
                                    <table class="table table-borderless">
                                        <tr>
                                            <td><strong>ID:</strong></td>
                                            <td>@Model.WriterId</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Ad Soyad:</strong></td>
                                            <td>@Model.WriterName</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Email:</strong></td>
                                            <td>@Model.WriterEmail</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Durum:</strong></td>
                                            <td>
                                                @if (Model.WriterStatus)
                                                {
                                                    <span class="badge badge-success">Aktif</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-danger">Pasif</span>
                                                }
                                            </td>
                                        </tr>
                                        <tr>
                                            <td><strong>Hakkında:</strong></td>
                                            <td>@Model.WriterAbout</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-12">
                            <a href="/Admin/Writer/UpdateWriter/@Model.WriterId" class="btn btn-warning">
                                <i class="fas fa-edit"></i> Düzenle
                            </a>
                            <a href="/Admin/Writer/Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Geri Dön
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
