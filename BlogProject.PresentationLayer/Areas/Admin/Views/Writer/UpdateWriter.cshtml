@model BlogProject.EntityLayer.Concrete.Writer
@{
    ViewData["Title"] = "Yazar Düzenle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Yazar Düzenle</h3>
                </div>
                <div class="card-body">
                    <form asp-action="UpdateWriter" method="post">
                        <input asp-for="WriterId" type="hidden" />
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="WriterName">Ad Soyad</label>
                                    <input asp-for="WriterName" class="form-control" placeholder="Yazar adını giriniz" />
                                    <span asp-validation-for="WriterName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="WriterEmail">Email</label>
                                    <input asp-for="WriterEmail" type="email" class="form-control" placeholder="Email adresini giriniz" />
                                    <span asp-validation-for="WriterEmail" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="WriterPassword">Şifre</label>
                                    <input asp-for="WriterPassword" type="password" class="form-control" placeholder="Şifreyi giriniz" />
                                    <span asp-validation-for="WriterPassword" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="WriterImage">Profil Resmi URL</label>
                                    <input asp-for="WriterImage" class="form-control" placeholder="Profil resmi URL'sini giriniz" />
                                    <span asp-validation-for="WriterImage" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <div class="form-group">
                                    <label asp-for="WriterAbout">Hakkında</label>
                                    <textarea asp-for="WriterAbout" class="form-control" rows="5" placeholder="Yazar hakkında bilgi giriniz"></textarea>
                                    <span asp-validation-for="WriterAbout" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> Güncelle
                            </button>
                            <a href="/Admin/Writer/Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Geri Dön
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
