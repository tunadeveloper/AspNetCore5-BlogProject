@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<BlogProject.EntityLayer.Concrete.Writer>
@{
    ViewData["Title"] = "Yazar Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Yazar Yönetimi</h3>
                    <div class="card-tools">
                        <a href="/Admin/Writer/CreateWriter" class="btn btn-primary btn-sm">
                            <i class="fas fa-plus"></i> Yeni Yazar Ekle
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Ad Soyad</th>
                                <th>Email</th>
                                <th>Hakkında</th>
                                <th>Durum</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.WriterId</td>
                                    <td>@item.WriterName</td>
                                    <td>@item.WriterEmail</td>
                                    <td>@(item.WriterAbout?.Length > 50 ? item.WriterAbout.Substring(0, 50) + "..." : item.WriterAbout)</td>
                                    <td>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input status-toggle" type="checkbox" 
                                                   data-id="@item.WriterId" 
                                                   @(item.WriterStatus ? "checked" : "")>
                                        </div>
                                    </td>
                                    <td>
                                        <a href="/Admin/Writer/WriterDetails/@item.WriterId" class="btn btn-info btn-sm">
                                            <i class="fas fa-eye"></i> Detay
                                        </a>
                                        <a href="/Admin/Writer/UpdateWriter/@item.WriterId" class="btn btn-warning btn-sm">
                                            <i class="fas fa-edit"></i> Düzenle
                                        </a>
                                        <a href="/Admin/Writer/DeleteWriter/@item.WriterId" class="btn btn-danger btn-sm" 
                                           onclick="return confirm('Bu yazarı silmek istediğinizden emin misiniz?')">
                                            <i class="fas fa-trash"></i> Sil
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    
                    <div class="pagination">
                        @Html.PagedListPager(Model, page => Url.Action("Index", new { page }))
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    $('.status-toggle').change(function() {
        var id = $(this).data('id');
        var status = $(this).is(':checked');
        
        $.post('/Admin/Writer/ChangeStatus', { id: id, status: status }, function(result) {
            if (result.success) {
                toastr.success('Durum başarıyla güncellendi');
            } else {
                toastr.error('Durum güncellenirken hata oluştu');
            }
        });
    });
});
</script>
