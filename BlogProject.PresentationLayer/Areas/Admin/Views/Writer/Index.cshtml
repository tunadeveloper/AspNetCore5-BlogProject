@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<BlogProject.EntityLayer.Concrete.Writer>
@{
    ViewData["Title"] = "Yazar Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="mb-0">Yazar Yönetimi</h5>
        <a href="/Admin/Writer/CreateWriter" class="btn btn-modern" style="background: linear-gradient(90deg, #6366f1, #8b5cf6); color: white;">
            <i class="fas fa-plus me-2"></i>Yeni Yazar Ekle
        </a>
    </div>
    <div class="table-responsive">
        <table class="admin-table table table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Ad Soyad</th>
                    <th>Email</th>
                    <th>Hakkında</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.WriterId</td>
                        <td>@item.WriterName</td>
                        <td>@item.WriterEmail</td>
                        <td>@(item.WriterAbout?.Length > 50 ? item.WriterAbout.Substring(0, 50) + "..." : item.WriterAbout)</td>
                        <td>
                            <div class="form-check form-switch">
                                <input class="form-check-input status-toggle" type="checkbox" 
                                       data-id="@item.WriterId" 
                                       id="status_@item.WriterId"
                                       @(item.WriterStatus ? "checked" : "")>
                            </div>
                        </td>
                        <td>
                            <a href="/Admin/Writer/WriterDetails/@item.WriterId" class="btn btn-sm btn-info">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="/Admin/Writer/UpdateWriter/@item.WriterId" class="btn btn-sm btn-warning">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a href="/Admin/Writer/DeleteWriter/@item.WriterId" class="btn btn-sm btn-danger" 
                               onclick="return confirm('Bu yazarı silmek istediğinizden emin misiniz?')">
                                <i class="fas fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <div class="pagination">
        @Html.PagedListPager(Model, page => Url.Action("Index", new { page }))
    </div>
</div>

<script>
$(document).ready(function() {
    $('.status-toggle').change(function() {
        var id = $(this).data('id');
        var status = $(this).is(':checked');
        var checkbox = $(this);
        
        $.ajax({
            url: '/Admin/Writer/ChangeStatus',
            type: 'POST',
            data: { id: id, status: status },
            success: function(result) {
                if (result.success) {
                    checkbox.prop('checked', result.newStatus);
                } else {
                    checkbox.prop('checked', !status);
                    alert('Durum güncellenirken hata oluştu');
                }
            },
            error: function() {
                checkbox.prop('checked', !status);
                alert('Durum güncellenirken hata oluştu');
            }
        });
    });
});
</script>
