@using X.PagedList
@using X.PagedList.Mvc.Core
@using Microsoft.AspNetCore.Identity
@model IPagedList<BlogProject.EntityLayer.Concrete.Message2>
@inject UserManager<IdentityUser<int>> UserManager
@{
    ViewData["Title"] = "Mesaj Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var currentUser = await UserManager.GetUserAsync(User);
    var currentUserId = currentUser?.Id ?? 1;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Mesaj Yönetimi</h3>
                    <div class="card-tools">
                        <a href="/Admin/Message/CreateMessage" class="btn btn-primary btn-sm">
                            <i class="fas fa-plus"></i> Yeni Mesaj
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Tür</th>
                                <th>Gönderen</th>
                                <th>Alıcı</th>
                                <th>Konu</th>
                                <th>İçerik</th>
                                <th>Tarih</th>
                                <th>Durum</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.MessageId</td>
                                    <td>
                                        @if (item.SenderId == currentUserId)
                                        {
                                            <span class="badge badge-primary">Gönderilen</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-success">Alınan</span>
                                        }
                                    </td>
                                    <td>@(item.SenderUser?.WriterName ?? "Bilinmiyor")</td>
                                    <td>@(item.ReceiverUser?.WriterName ?? "Bilinmiyor")</td>
                                    <td>@(string.IsNullOrEmpty(item.Subject) ? "Konu yok" : item.Subject)</td>
                                    <td>@(string.IsNullOrEmpty(item.Content) ? "İçerik yok" : (item.Content.Length > 50 ? item.Content.Substring(0, 50) + "..." : item.Content))</td>
                                    <td>@item.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input status-toggle" type="checkbox" 
                                                   data-id="@item.MessageId" 
                                                   @(item.Status ? "checked" : "")>
                                        </div>
                                    </td>
                                    <td>
                                        <a href="/Admin/Message/MessageDetails/@item.MessageId" class="btn btn-info btn-sm">
                                            <i class="fas fa-eye"></i> Detay
                                        </a>
                                        <a href="/Admin/Message/UpdateMessage/@item.MessageId" class="btn btn-warning btn-sm">
                                            <i class="fas fa-edit"></i> Düzenle
                                        </a>
                                        <a href="/Admin/Message/DeleteMessage/@item.MessageId" class="btn btn-danger btn-sm" 
                                           onclick="return confirm('Bu mesajı silmek istediğinizden emin misiniz?')">
                                            <i class="fas fa-trash"></i> Sil
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    
                    <div class="pagination">
                        @Html.PagedListPager(Model, page => Url.Action("Index", new { page }))
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    $('.status-toggle').change(function() {
        var id = $(this).data('id');
        var status = $(this).is(':checked');
        
        $.post('/Admin/Message/ChangeStatus', { id: id, status: status }, function(result) {
            if (result.success) {
                toastr.success('Durum başarıyla güncellendi');
            } else {
                toastr.error('Durum güncellenirken hata oluştu');
            }
        });
    });
});
</script>
