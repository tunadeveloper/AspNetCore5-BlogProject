@model BlogProject.EntityLayer.Concrete.Message2
@{
    ViewData["Title"] = "Mesaj Düzenle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Mesaj Düzenle</h3>
                </div>
                <div class="card-body">
                    <form asp-action="UpdateMessage" method="post">
                        <input asp-for="MessageId" type="hidden" />
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Gönderen</label>
                                    <input type="text" class="form-control" value="@(Model.SenderUser?.WriterName ?? "Bilinmiyor")" readonly />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="ReceiverId">Alıcı</label>
                                    <select asp-for="ReceiverId" class="form-control">
                                        <option value="">Alıcı Seçiniz</option>
                                        @foreach (var writer in ViewBag.Writers)
                                        {
                                            <option value="@writer.WriterId">@writer.WriterName</option>
                                        }
                                    </select>
                                    <span asp-validation-for="ReceiverId" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <div class="form-group">
                                    <label asp-for="Subject">Konu</label>
                                    <input asp-for="Subject" class="form-control" placeholder="Mesaj konusunu giriniz" />
                                    <span asp-validation-for="Subject" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <div class="form-group">
                                    <label asp-for="Content">Mesaj İçeriği</label>
                                    <textarea asp-for="Content" class="form-control" rows="8" placeholder="Mesaj içeriğini giriniz"></textarea>
                                    <span asp-validation-for="Content" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> Güncelle
                            </button>
                            <a href="/Admin/Message/Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Geri Dön
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
