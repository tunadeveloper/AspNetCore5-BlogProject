@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<BlogProject.EntityLayer.Concrete.Newsletter>
@{
    ViewData["Title"] = "Bülten Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="mb-0">Bülten Yönetimi</h5>
        <span class="badge" style="background: #f8fafc; color: #64748b;">Sadece Görüntüleme ve Silme</span>
    </div>
    <div class="table-responsive">
        <table class="admin-table table table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Email</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.NewsletterId</td>
                        <td>@item.Email</td>
                        <td>
                            <div class="form-check form-switch">
                                <input class="form-check-input status-toggle" type="checkbox" 
                                       data-id="@item.NewsletterId" 
                                       id="status_@item.NewsletterId"
                                       @(item.EmailStaus ? "checked" : "")>
                            </div>
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-danger delete-newsletter" 
                                    data-id="@item.NewsletterId" 
                                    data-email="@item.Email">
                                <i class="fas fa-trash"></i> Sil
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <div class="pagination">
        @Html.PagedListPager(Model, page => Url.Action("Index", new { page }))
    </div>
</div>

<script>
$(document).ready(function() {
    $('.status-toggle').change(function() {
        var id = $(this).data('id');
        var status = $(this).is(':checked');
        var checkbox = $(this);
        
        $.ajax({
            url: '/Admin/Newsletter/ChangeStatus',
            type: 'POST',
            data: { id: id, status: status },
            success: function(result) {
                if (result.success) {
                    checkbox.prop('checked', result.newStatus);
                } else {
                    checkbox.prop('checked', !status);
                    alert('Durum güncellenirken hata oluştu');
                }
            },
            error: function() {
                checkbox.prop('checked', !status);
                alert('Durum güncellenirken hata oluştu');
            }
        });
    });

    $('.delete-newsletter').click(function() {
        var id = $(this).data('id');
        var email = $(this).data('email');
        var button = $(this);
        
        if (confirm(`"${email}" adresini bülten listesinden silmek istediğinizden emin misiniz?`)) {
            $.ajax({
                url: '/Admin/Newsletter/DeleteNewsletter',
                type: 'POST',
                data: { id: id },
                success: function(response) {
                    if (response.success) {
                        button.closest('tr').fadeOut(300, function() {
                            $(this).remove();
                        });
                    } else {
                        alert(response.message || 'Silme işlemi başarısız');
                    }
                },
                error: function() {
                    alert('Silme işlemi sırasında hata oluştu');
                }
            });
        }
    });
});
</script>
