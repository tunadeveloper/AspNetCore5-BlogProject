@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<BlogProject.EntityLayer.Concrete.Newsletter>
@{
    ViewData["Title"] = "Bülten Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Bülten Yönetimi</h3>
                    <div class="card-tools">
                        <span class="badge badge-info">Sadece Görüntüleme ve Silme</span>
                    </div>
                </div>
                <div class="card-body">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Email</th>
                                <th>Durum</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.NewsletterId</td>
                                    <td>@item.Email</td>
                                    <td>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input status-toggle" type="checkbox" 
                                                   data-id="@item.NewsletterId" 
                                                   @(item.EmailStaus ? "checked" : "")>
                                        </div>
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-danger btn-sm delete-newsletter" 
                                                data-id="@item.NewsletterId" 
                                                data-email="@item.Email">
                                            <i class="fas fa-trash"></i> Sil
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    
                    <div class="pagination">
                        @Html.PagedListPager(Model, page => Url.Action("Index", new { page }))
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    $('.status-toggle').change(function() {
        var id = $(this).data('id');
        var status = $(this).is(':checked');
        
        $.post('/Admin/Newsletter/ChangeStatus', { id: id, status: status }, function(result) {
            if (result.success) {
                toastr.success('Durum başarıyla güncellendi');
            } else {
                toastr.error('Durum güncellenirken hata oluştu');
            }
        });
    });

    $('.delete-newsletter').click(function() {
        var id = $(this).data('id');
        var email = $(this).data('email');
        
        Swal.fire({
            title: 'Emin misiniz?',
            text: `"${email}" adresini bülten listesinden silmek istediğinizden emin misiniz?`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Evet, Sil!',
            cancelButtonText: 'İptal'
        }).then((result) => {
            if (result.isConfirmed) {
                $.post('/Admin/Newsletter/DeleteNewsletter', { id: id }, function(response) {
                    if (response.success) {
                        Swal.fire('Silindi!', response.message, 'success').then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Hata!', response.message, 'error');
                    }
                });
            }
        });
    });
});
</script>
