@model BlogProject.EntityLayer.Concrete.Newsletter
@{
    ViewData["Title"] = "Bülten Düzenle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Bülten Düzenle</h3>
                </div>
                <div class="card-body">
                    <form asp-action="UpdateNewsletter" method="post">
                        <input asp-for="NewsletterId" type="hidden" />
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Email">Email Adresi</label>
                                    <input asp-for="Email" type="email" class="form-control" placeholder="Email adresini giriniz" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> Güncelle
                            </button>
                            <a href="/Admin/Newsletter/Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Geri Dön
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
