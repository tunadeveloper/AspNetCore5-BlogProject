@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<BlogProject.EntityLayer.Concrete.Blog>
@{
    ViewData["Title"] = "Blog Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="mb-0">Blog Yönetimi</h5>
        <a href="/Admin/Blog/CreateBlog" class="btn btn-modern" style="background: linear-gradient(90deg, #6366f1, #8b5cf6); color: white;">
            <i class="fas fa-plus me-2"></i>Yeni Blog
        </a>
    </div>
    <div class="table-responsive">
        <table class="admin-table table table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Başlık</th>
                    <th>Kategori</th>
                    <th>Yazar</th>
                    <th>Tarih</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.BlogId</td>
                        <td>@(item.BlogTitle?.Length > 30 ? item.BlogTitle.Substring(0, 30) + "..." : item.BlogTitle)</td>
                        <td><span class="badge" style="background: linear-gradient(90deg, #6366f1, #8b5cf6); color: white;">@item.Category?.CategoryName</span></td>
                        <td>@item.Writer?.WriterName</td>
                        <td>@item.BlogCreateDate.ToString("dd.MM.yyyy")</td>
                        <td>
                            <div class="form-check form-switch">
                                <input class="form-check-input status-toggle" type="checkbox" 
                                       data-id="@item.BlogId" 
                                       id="status_@item.BlogId"
                                       @(item.BlogStatus ? "checked" : "")>
                            </div>
                        </td>
                        <td>
                            <a href="/Admin/Blog/BlogDetails/@item.BlogId" class="btn btn-sm btn-info">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="/Admin/Blog/UpdateBlog/@item.BlogId" class="btn btn-sm btn-warning">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a href="/Admin/Blog/DeleteBlog/@item.BlogId" class="btn btn-sm btn-danger" 
                               onclick="return confirm('Bu blog yazısını silmek istediğinizden emin misiniz?')">
                                <i class="fas fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <div class="pagination">
        @Html.PagedListPager(Model, page => Url.Action("Index", new { page }))
    </div>
</div>

<script>
$(document).ready(function() {
    $('.status-toggle').change(function() {
        var id = $(this).data('id');
        var status = $(this).is(':checked');
        var checkbox = $(this);
        
        $.ajax({
            url: '/Admin/Blog/ChangeStatus',
            type: 'POST',
            data: { id: id, status: status },
            success: function(result) {
                if (result.success) {
                    checkbox.prop('checked', result.newStatus);
                } else {
                    checkbox.prop('checked', !status);
                    alert('Durum güncellenirken hata oluştu');
                }
            },
            error: function() {
                checkbox.prop('checked', !status);
                alert('Durum güncellenirken hata oluştu');
            }
        });
    });
});
</script>
