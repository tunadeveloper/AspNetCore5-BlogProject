@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<BlogProject.EntityLayer.Concrete.Blog>
@{
    ViewData["Title"] = "Blog Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Blog Yönetimi</h3>
                    <div class="card-tools">
                        <a href="/Admin/Blog/CreateBlog" class="btn btn-primary btn-sm">
                            <i class="fas fa-plus"></i> Yeni Blog
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Başlık</th>
                                <th>Kategori</th>
                                <th>Yazar</th>
                                <th>Tarih</th>
                                <th>Durum</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.BlogId</td>
                                    <td>@(item.BlogTitle?.Length > 30 ? item.BlogTitle.Substring(0, 30) + "..." : item.BlogTitle)</td>
                                    <td>@item.Category?.CategoryName</td>
                                    <td>@item.Writer?.WriterName</td>
                                    <td>@item.BlogCreateDate.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input status-toggle" type="checkbox" 
                                                   data-id="@item.BlogId" 
                                                   @(item.BlogStatus ? "checked" : "")>
                                        </div>
                                    </td>
                                    <td>
                                        <a href="/Admin/Blog/BlogDetails/@item.BlogId" class="btn btn-info btn-sm">
                                            <i class="fas fa-eye"></i> Detay
                                        </a>
                                        <a href="/Admin/Blog/UpdateBlog/@item.BlogId" class="btn btn-warning btn-sm">
                                            <i class="fas fa-edit"></i> Düzenle
                                        </a>
                                        <a href="/Admin/Blog/DeleteBlog/@item.BlogId" class="btn btn-danger btn-sm" 
                                           onclick="return confirm('Bu blog yazısını silmek istediğinizden emin misiniz?')">
                                            <i class="fas fa-trash"></i> Sil
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    
                    <div class="pagination">
                        @Html.PagedListPager(Model, page => Url.Action("Index", new { page }))
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    $('.status-toggle').change(function() {
        var id = $(this).data('id');
        var status = $(this).is(':checked');
        
        $.post('/Admin/Blog/ChangeStatus', { id: id, status: status }, function(result) {
            if (result.success) {
                toastr.success('Durum başarıyla güncellendi');
            } else {
                toastr.error('Durum güncellenirken hata oluştu');
            }
        });
    });
});
</script>
