@model BlogProject.EntityLayer.Concrete.Blog
@{
    ViewData["Title"] = "Blog Detayları";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Blog Detayları</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8">
                            <h2>@Model.BlogTitle</h2>
                            <div class="mb-3">
                                <span class="badge badge-info">@Model.Category?.CategoryName</span>
                                <span class="badge badge-secondary">@Model.Writer?.WriterName</span>
                                <span class="badge badge-light">@Model.BlogCreateDate.ToString("dd.MM.yyyy HH:mm")</span>
                            </div>
                            
                            @if (!string.IsNullOrEmpty(Model.BlogImage))
                            {
                                <div class="mb-4">
                                    <img src="@Model.BlogImage" class="img-fluid rounded" alt="Blog Resmi">
                                </div>
                            }
                            
                            <div class="blog-content">
                                @Html.Raw(Model.BlogContent?.Replace("\n", "<br>"))
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card">
                                <div class="card-header">
                                    <h5>Blog Bilgileri</h5>
                                </div>
                                <div class="card-body">
                                    <table class="table table-borderless table-sm">
                                        <tr>
                                            <td><strong>ID:</strong></td>
                                            <td>@Model.BlogId</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Kategori:</strong></td>
                                            <td>@Model.Category?.CategoryName</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Yazar:</strong></td>
                                            <td>@Model.Writer?.WriterName</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Tarih:</strong></td>
                                            <td>@Model.BlogCreateDate.ToString("dd.MM.yyyy HH:mm")</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Durum:</strong></td>
                                            <td>
                                                @if (Model.BlogStatus)
                                                {
                                                    <span class="badge badge-success">Aktif</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-danger">Pasif</span>
                                                }
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                            
                            @if (!string.IsNullOrEmpty(Model.BlogThumnailImage))
                            {
                                <div class="card mt-3">
                                    <div class="card-header">
                                        <h6>Küçük Resim</h6>
                                    </div>
                                    <div class="card-body text-center">
                                        <img src="@Model.BlogThumnailImage" class="img-fluid" alt="Küçük Resim">
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-12">
                            <a href="/Admin/Blog/UpdateBlog/@Model.BlogId" class="btn btn-warning">
                                <i class="fas fa-edit"></i> Düzenle
                            </a>
                            <a href="/Admin/Blog/Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Geri Dön
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
