@using BlogProject.EntityLayer.Concrete
@model Category

@{
    ViewData["Title"] = "Kategori Ekle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        <div class="ibox ">
            <div class="ibox-title">
                <h5>Kategori Ekle</h5>
            </div>
            <div class="ibox-content">
                <form asp-action="CreateCategory" method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label>Kategori Adı</label>
                        <input asp-for="CategoryName" class="form-control" />
                        <span asp-validation-for="CategoryName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label>Açıklama</label>
                        <textarea asp-for="CategoryDescription" class="form-control"></textarea>
                        <span asp-validation-for="CategoryDescription" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-success mt-2">Ekle</button>
                </form>
            </div>
        </div>
    </div>
</div>
